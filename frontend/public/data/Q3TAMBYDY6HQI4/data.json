  "rootCauseSteps": [

    {
      "id": "2",
      "title": "Lack of available disk space or inodes in the /tmp directory",
      "description": "The error is likely caused by a lack of available disk space or inodes in the /tmp directory or its underlying filesystem.\n\n When the /tmp directory becomes full, either due to excessive data stored or a large number of small files consuming all inodes, the system is unable to create new temporary files. This results in IOExceptions during write attempts by services relying on /tmp, such as reporting jobs. Even if disk space appears sufficient, inode exhaustion can prevent file creation, leading to similar failures.",
      "status": "in_progress",
      "recommendedAction": "Clean the /tmp directory to ensure sufficient disk space and available inodes."
    }

  ]
